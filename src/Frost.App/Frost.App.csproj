<Project Sdk="Microsoft.NET.Sdk">
  <!-- WPF owns startup and the PerMonitorV2 manifest; WinForms is only used for NotifyIcon. -->
  <PropertyGroup><OutputType>WinExe</OutputType><UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms><ApplicationManifest>app.manifest</ApplicationManifest><AssemblyName>FrostWhiteComet</AssemblyName><Version>1.1.0</Version><ApplicationIcon>../../assets/frost.ico</ApplicationIcon><NoWarn>$(NoWarn);WFAC010</NoWarn></PropertyGroup>
  <ItemGroup><ProjectReference Include="../Frost.Core/Frost.Core.csproj"/><Content Include="../../assets/frost.ico"><Link>frost.ico</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory><CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory><ExcludeFromSingleFile>true</ExcludeFromSingleFile></Content><Content Include="../../assets/cursors/**/*"><Link>Theme/%(RecursiveDir)%(Filename)%(Extension)</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory><CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory><ExcludeFromSingleFile>true</ExcludeFromSingleFile></Content></ItemGroup>
  <ItemGroup><Content Include="../../assets/themes/**/*"><Link>Themes/%(RecursiveDir)%(Filename)%(Extension)</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory><CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory><ExcludeFromSingleFile>true</ExcludeFromSingleFile></Content><Content Include="../../assets/catalog/**/*"><Link>Catalog/%(RecursiveDir)%(Filename)%(Extension)</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory><CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory><ExcludeFromSingleFile>true</ExcludeFromSingleFile></Content></ItemGroup>
  <PropertyGroup><Product>CURSORIUM — Cursor &amp; Motion Studio</Product><Title>CURSORIUM</Title><Description>Native Windows cursor themes, motion effects and local profiles.</Description></PropertyGroup>
</Project>
