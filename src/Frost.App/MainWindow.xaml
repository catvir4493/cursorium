<Window x:Class="Frost.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Frost.App" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="CURSORIUM — Cursor &amp; Motion Studio" Width="1280" Height="830" MinWidth="780" MinHeight="480" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="13" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Presentation/DesignTokens.xaml"/>
        <ResourceDictionary Source="Presentation/Icons.xaml"/>
        <ResourceDictionary Source="Presentation/Controls.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <Style x:Key="Card" TargetType="Border" BasedOn="{StaticResource SettingsSection}"/>
      <Style x:Key="NavItem" TargetType="ListBoxItem" BasedOn="{StaticResource NavigationItem}"/>
      <Style x:Key="LibraryThemeCard" TargetType="ListBoxItem" BasedOn="{StaticResource ThemeCard}"><Setter Property="Height" Value="Auto"/><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
    </ResourceDictionary>
  </Window.Resources>

  <Border x:Name="RootFrame" Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions><RowDefinition x:Name="TitleRow" Height="48"/><RowDefinition/></Grid.RowDefinitions>
      <Border x:Name="CustomTitleBar" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Button x:Name="MinimizeButton" Style="{StaticResource IconButton}" Width="46" Height="47" Click="MinimizeWindow" ToolTip="Minimize" AutomationProperties.Name="Minimize"><Path Data="{StaticResource MinimizeIcon}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.2" Width="11" Stretch="Uniform"/></Button>
            <Button x:Name="MaximizeButton" Style="{StaticResource IconButton}" Width="46" Height="47" Click="MaximizeWindow" ToolTip="Maximize or restore" AutomationProperties.Name="Maximize or restore"><Path x:Name="MaximizeGlyph" Data="{StaticResource MaximizeIcon}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.2" Width="11" Height="11" Stretch="Uniform"/></Button>
            <Button x:Name="CloseButton" Style="{StaticResource IconButton}" Width="46" Height="47" Click="CloseWindow" ToolTip="Close to tray" AutomationProperties.Name="Close to tray"><Path Data="{StaticResource CloseIcon}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.2" Width="11" Height="11" Stretch="Uniform"/></Button>
          </StackPanel>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0"><Path Data="{StaticResource LogoIcon}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.4" Width="18" Height="18" Stretch="Uniform"/><TextBlock Text="CURSORIUM" FontSize="14" FontWeight="SemiBold" Margin="10,0,0,0"/><TextBlock Text="Cursor &amp; Motion Studio" Style="{StaticResource Caption}" Margin="16,2,0,0"/></StackPanel>
        </DockPanel>
      </Border>
      <Grid Grid.Row="1" Margin="16,20,16,16">
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="NavColumn" Width="184"/><ColumnDefinition/><ColumnDefinition x:Name="ParameterColumn" Width="320"/></Grid.ColumnDefinitions>
        <Grid Margin="0,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock x:Name="WorkspaceLabel" Text="WORKSPACE" Style="{StaticResource Caption}" Margin="12,0,0,16"/>
          <ListBox x:Name="Navigation" Grid.Row="1" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource NavigationItem}" SelectionChanged="Navigate" AutomationProperties.Name="Studio navigation">
<ListBoxItem ToolTip="Explore" AutomationProperties.Name="Explore"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource ExploreIcon}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.3" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/><TextBlock x:Name="NavExploreLabel" Text="Explore" Margin="12,0,0,0"/></StackPanel></ListBoxItem><ListBoxItem ToolTip="Cursors" AutomationProperties.Name="Cursors"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource CursorIcon}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.3" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/><TextBlock x:Name="NavCursorLabel" Text="Cursors" Margin="12,0,0,0"/></StackPanel></ListBoxItem><ListBoxItem ToolTip="Trails" AutomationProperties.Name="Trails"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource TrailIcon}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.3" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/><TextBlock x:Name="NavTrailLabel" Text="Trails" Margin="12,0,0,0"/></StackPanel></ListBoxItem><ListBoxItem ToolTip="Mix Studio" AutomationProperties.Name="Mix Studio"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource MixIcon}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.3" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/><TextBlock x:Name="NavMixLabel" Text="Mix Studio" Margin="12,0,0,0"/></StackPanel></ListBoxItem><ListBoxItem ToolTip="Settings" AutomationProperties.Name="Settings"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource SettingsIcon}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.3" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/><TextBlock x:Name="NavSettingsLabel" Text="Settings" Margin="12,0,0,0"/></StackPanel></ListBoxItem></ListBox>
          <StackPanel Grid.Row="2" Margin="12,20,0,8"><StackPanel Orientation="Horizontal"><Ellipse x:Name="RuntimeIndicator" Style="{StaticResource StatusIndicator}"/><TextBlock x:Name="NavRuntimeLabel" Text="Desktop studio" Style="{StaticResource Caption}" Margin="8,0,0,0"/></StackPanel><TextBlock x:Name="NavVersionLabel" Text="v1.2 · Local workspace" Style="{StaticResource Caption}" Margin="0,8,0,0"/></StackPanel>
        </Grid>
    <ContentControl x:Name="DiscoverHost" Grid.Column="1" Grid.ColumnSpan="2" Margin="20,0,0,0" Visibility="Collapsed"/>
    <Grid x:Name="StudioContent" Grid.Column="1" Margin="20,0,20,0">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Margin="0,0,0,12"><DockPanel><Border DockPanel.Dock="Right" Background="{DynamicResource SurfaceBrush}" CornerRadius="4" Padding="8,3" VerticalAlignment="Top"><TextBlock x:Name="StateBadge" ToolTip="{Binding AppliedSummary}" Text="{Binding StateLabel}" FontSize="11" Foreground="{DynamicResource AccentBrush}"/></Border><TextBlock x:Name="PageLabel" Text="EXPLORE" Style="{StaticResource Caption}"/></DockPanel><TextBlock x:Name="ThemeTitle" Style="{StaticResource PageHeader}" MaxHeight="64" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}" Margin="0,6,0,4"/><TextBlock x:Name="ThemeDescription" Style="{StaticResource Caption}" MaxHeight="34" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}"/><TextBlock x:Name="CombinationLabel" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource AccentBrush}" FontSize="11" Margin="0,8,0,0"/></StackPanel>
      <ScrollViewer x:Name="ContentScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
        <StackPanel>
          <Border x:Name="PreviewContainer" Style="{StaticResource PreviewPanel}" Margin="0,0,0,18">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Grid Margin="16,7"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image x:Name="HeroImage" Width="22" Height="22"/><TextBlock Text="Live Preview" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel><ComboBox x:Name="PreviewRole" Grid.Column="1" SelectionChanged="PreviewRoleChanged" AutomationProperties.Name="Preview or import cursor role"/></Grid>
              <Grid x:Name="TestArea" Grid.Row="1" Height="340" ClipToBounds="True">
                <Grid.Background><DrawingBrush TileMode="Tile" Viewport="0,0,32,32" ViewportUnits="Absolute"><DrawingBrush.Drawing><GeometryDrawing Brush="{DynamicResource PreviewBrush}"><GeometryDrawing.Pen><Pen Brush="{DynamicResource PreviewGridBrush}" Thickness="0.5"/></GeometryDrawing.Pen><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,32,32"/></GeometryDrawing.Geometry></GeometryDrawing></DrawingBrush.Drawing></DrawingBrush></Grid.Background>
                <StackPanel x:Name="PreviewHint" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock Text="Move. Click. Try it." FontSize="17" TextAlignment="Center"/><TextBlock Text="Your current draft, inside this area." Style="{StaticResource Caption}" Margin="12,8,12,0" TextAlignment="Center"/></StackPanel>
                <local:LivePreview x:Name="Preview" Focusable="True" AutomationProperties.Name="Live cursor and motion preview"/>
              </Grid>
              <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,8"><TextBlock Text="PREVIEW ONLY · Windows changes when you apply." Style="{StaticResource Caption}"/></Border>
            </Grid>
          </Border>
          <StackPanel x:Name="ThemeLibrary" Margin="0,0,0,14">
            <DockPanel Margin="0,0,0,12"><ComboBox x:Name="LibraryFilter" DockPanel.Dock="Right" Width="158" SelectionChanged="FilterChanged" AutomationProperties.Name="Filter cursor library"><ComboBoxItem Content="All Themes" Tag="all"/><ComboBoxItem Content="Built-in" Tag="built-in"/><ComboBoxItem Content="Cute Collection" Tag="cute"/><ComboBoxItem Content="Imported" Tag="imported"/><ComboBoxItem Content="Favorites" Tag="favorites"/><ComboBoxItem Content="Downloaded" Tag="downloaded"/></ComboBox><StackPanel VerticalAlignment="Center"><TextBlock Text="My Cursor Library" FontWeight="SemiBold"/><TextBlock x:Name="LibraryCount" Style="{StaticResource Caption}"/></StackPanel></DockPanel>
        <ListBox x:Name="ThemeCards" SizeChanged="LibraryResized" SelectionChanged="ThemeCardChanged" Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="0" ItemContainerStyle="{StaticResource LibraryThemeCard}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="Available cursor themes"><ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate><StackPanel><Grid><Image Source="{Binding Cover}" Height="140" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="NearestNeighbor"/><Button HorizontalAlignment="Right" VerticalAlignment="Top" Content="{Binding FavoriteGlyph}" ToolTip="{Binding FavoriteAction}" AutomationProperties.Name="{Binding FavoriteAction}" Tag="favorite" Background="{DynamicResource SurfaceBrush}" Width="28" Height="28" MinHeight="28" Padding="0" Margin="0,8,8,0" Click="FavoriteClicked"/></Grid><StackPanel Margin="10,9,10,11"><TextBlock Text="{Binding Theme.Name}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Theme.Name}" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="{Binding Theme.Author}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Theme.Author}" Style="{StaticResource Caption}" Margin="0,4,0,0"/><DockPanel Margin="0,5,0,0"><TextBlock Text="{Binding Ownership}" Style="{StaticResource Caption}" Margin="0,0,8,0"/><TextBlock Text="{Binding AnimationLabel}" Style="{StaticResource Caption}"/></DockPanel><TextBlock Text="{Binding Theme.RoleSummary}" FontSize="10" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Theme.RoleSummary}" Margin="0,3,0,0"/><TextBlock Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource AccentBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" MinHeight="15" Margin="0,5,0,0"/></StackPanel></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
            <TextBlock Text="Selected = draft · Applied = desktop · Modified = unapplied edits" Style="{StaticResource Caption}" Margin="0,0,0,8"/>

          </StackPanel>
          <StackPanel x:Name="CursorPage" Visibility="Collapsed">
            <WrapPanel Margin="0,0,0,16"><Button Content="Find more in Explore" Click="FindMore" Margin="0,0,8,8"/><Button x:Name="RemoveThemeButton" Style="{StaticResource DestructiveButton}" Content="Remove from Library" Click="RemoveSelectedTheme" Margin="0,0,0,8"/></WrapPanel><TextBlock Text="Pointer roles" FontWeight="SemiBold"/>
            <UniformGrid x:Name="RoleGrid" Columns="5" Margin="0,0,0,12"/>
            <Expander x:Name="ThemeDetails" Header="Selected theme details"><StackPanel><TextBlock x:Name="ThemeDetailsTitle" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="ThemeDetailsText" Style="{StaticResource Caption}" Margin="0,8,0,0"/><Button x:Name="SourceButton" Click="OpenThemeSource" HorizontalContentAlignment="Left" Margin="0,8,0,0" ToolTip="Open original source in browser"/></StackPanel></Expander>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Import local .cur / .ani resources" FontSize="16"/><TextBlock Text="One file replaces the selected role. For multiple files, use the role names shown above (Normal.cur, Busy.ani…). Other roles inherit the selected theme." Style="{StaticResource Caption}" Margin="0,8,0,0"/><TextBox x:Name="ImportName" Text="My cursor theme" AutomationProperties.Name="Imported theme name"/><WrapPanel><Button x:Name="ImportButton" Content="Import cursor files…" Click="ImportFiles" Margin="0,0,8,8"/><Button x:Name="ImportPackButton" Content="Import Cursor Pack…" Click="ImportPack" Margin="0,0,8,8"/><Button x:Name="ImportDirectoryButton" Content="Import folder…" Click="ImportDirectory" Margin="0,0,0,8"/></WrapPanel><TextBlock Text="Packs are validated and role mappings reviewed. Only cursor resources are read. No scripts, installers or INF files are run." Style="{StaticResource Caption}"/></StackPanel></Border>
          </StackPanel>
          <StackPanel x:Name="TrailPage" Visibility="Collapsed"><WrapPanel Margin="0,0,0,16"><Button Content="Find motion presets in Explore" Click="FindMore" Margin="0,0,8,8"/><Button x:Name="RemoveTrailButton" Style="{StaticResource DestructiveButton}" Content="Remove preset" Click="RemoveSelectedTrail" Margin="0,0,0,8"/></WrapPanel><TextBlock Text="Motion presets" FontWeight="SemiBold"/><ListBox x:Name="TrailCards" SizeChanged="LibraryResized" SelectionChanged="TrailCardChanged" Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="0" ItemContainerStyle="{StaticResource LibraryThemeCard}" Margin="0,12,0,10" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate><StackPanel><Image Height="140" Stretch="UniformToFill" Loaded="TrailImageLoaded"/><StackPanel Margin="10,9,10,11"><TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><TextBlock Text="{Binding Origin}" Style="{StaticResource Caption}" Margin="0,5,0,0"/><TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Description}" Margin="0,5,0,0"/><TextBlock Text="{Binding StatusLabel}" FontSize="11" Foreground="{DynamicResource AccentBrush}" MinHeight="15" Margin="0,7,0,0"/></StackPanel></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock Text="Changing motion keeps your cursor and click effect. Fine-tune on the right, then Apply." Style="{StaticResource Caption}"/></StackPanel>
          <Border x:Name="MixPage" Visibility="Collapsed" Style="{StaticResource SettingsSection}"><StackPanel><TextBlock Text="Saved profiles" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Keep combinations you want to use again. Loading a profile changes the preview; Apply activates it." Style="{StaticResource Caption}" Margin="0,8,0,18"/><TextBlock Text="Profile"/><ComboBox x:Name="ProfileBox" SelectionChanged="ProfileSelected" DisplayMemberPath="Name" Margin="0,6,0,16" AutomationProperties.Name="Saved profiles"/><TextBlock Text="Profile name"/><TextBox x:Name="ProfileName" Text="My combination" Margin="0,6,0,16" AutomationProperties.Name="Profile name"/><WrapPanel><Button x:Name="NewProfileButton" Content="Create Profile" Click="CreateProfile" Margin="0,0,8,8"/><Button x:Name="SaveProfileButton" Content="Save" Click="SaveProfile" Margin="0,0,8,8"/><Button x:Name="RenameProfileButton" Content="Rename" Click="RenameProfile" Margin="0,0,8,8"/><Button x:Name="DeleteProfileButton" Content="Delete" Click="DeleteProfile" Margin="0,0,0,8"/></WrapPanel><TextBlock Text="Saving a profile does not apply it to Windows." Style="{StaticResource Caption}" Margin="0,10,0,0"/></StackPanel></Border>
          <StackPanel x:Name="SettingsPage" Visibility="Collapsed">
            <Border Style="{StaticResource SettingsSection}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Desktop behavior" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"/><CheckBox x:Name="FullscreenCheck" Content="Pause in fullscreen applications" Checked="ParameterToggle" Unchecked="ParameterToggle" Margin="0,0,0,10"/><CheckBox x:Name="PowerCheck" Content="Power saving · 30 FPS" Checked="ParameterToggle" Unchecked="ParameterToggle" Margin="0,0,0,12"/><TextBlock Text="Target frame rate" Style="{StaticResource Caption}"/><ComboBox x:Name="FpsBox" SelectionChanged="FpsChanged" Margin="0,6,0,16" AutomationProperties.Name="Target frame rate"><ComboBoxItem Content="60 FPS target"/><ComboBoxItem Content="120 FPS target"/></ComboBox><CheckBox x:Name="StartupCheck" Content="Start at sign-in in the tray" Checked="StartupChanged" Unchecked="StartupChanged"/><TextBlock Text="Startup changes immediately. Motion settings use Apply." Style="{StaticResource Caption}" Margin="0,10,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource SettingsSection}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Appearance" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"/><CheckBox x:Name="AnimationsCheck" Content="Interface animations" Checked="AppearanceChanged" Unchecked="AppearanceChanged" Margin="0,0,0,10"/><TextBlock Text="Respects Windows animation settings. Cursor effects use their own renderer." Style="{StaticResource Caption}" Margin="0,0,0,12"/><CheckBox x:Name="SystemTitleCheck" Content="Use the system title bar" Checked="AppearanceChanged" Unchecked="AppearanceChanged"/><TextBlock Text="Native dark caption fallback. Appearance is saved immediately." Style="{StaticResource Caption}" Margin="0,10,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource SettingsSection}"><StackPanel><TextBlock Text="Local data &amp; recovery" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Profiles, themes and the original cursor backup stay on this computer. Online resources use verified official HTTPS downloads. The signed catalog is cached for offline browsing; media cache is limited to 24 MiB. Preview and download staging are separate from installed themes." Style="{StaticResource Caption}" Margin="0,8,0,16"/><Button Content="Open local data folder" Click="OpenData" HorizontalAlignment="Left"/><TextBlock Text="Cursor recovery is in Customize → Cursor. Closing the window keeps the tray active; exit from the tray to stop the app." Style="{StaticResource Caption}" Margin="0,16,0,0"/><TextBlock Text="Protected desktops and exclusive fullscreen may not show effects." Style="{StaticResource Caption}" Margin="0,10,0,0"/></StackPanel></Border>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
      <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,12,0,0"><StackPanel><TextBlock x:Name="Feedback" Foreground="{DynamicResource SuccessBrush}" FontSize="11" MaxHeight="48" AutomationProperties.LiveSetting="Polite"/><TextBlock x:Name="EngineStatus" Style="{StaticResource Caption}" Margin="0,5,0,0"/></StackPanel></Border>
    </Grid>
    <Border x:Name="ConfigurationPanel" Grid.Column="2" Style="{StaticResource SettingsSection}" Padding="16">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16"><TextBlock Text="Customize" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding CursorName}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding CursorName}" Margin="0,10,0,3"/><TextBlock Text="{Binding TrailName}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding ProfileCaption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding ProfileCaption}" Style="{StaticResource Caption}" Margin="0,4,0,0"/><CheckBox x:Name="EnabledCheck" Content="Desktop effects" Margin="0,12,0,0" Checked="ParameterToggle" Unchecked="ParameterToggle"/></StackPanel>
        <TabControl x:Name="ConfigTabs" Grid.Row="1" Background="Transparent" BorderThickness="0" SelectedIndex="0" AutomationProperties.Name="Customization sections">
          <TabControl.Template><ControlTemplate TargetType="TabControl"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><Border Background="{DynamicResource ControlBrush}" CornerRadius="6" Padding="3"><UniformGrid IsItemsHost="True" Rows="1"/></Border><ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent" Margin="0,16,0,0"/></Grid></ControlTemplate></TabControl.Template>
          <TabItem Header="Trail" Style="{StaticResource SettingsTab}"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,8,4">
            <TextBlock Text="Motion preset" Style="{StaticResource Caption}"/><ComboBox x:Name="TrailBox" DisplayMemberPath="Name" SelectionChanged="TrailChanged" Margin="0,6,0,10" AutomationProperties.Name="Trail effect"/>
            <CheckBox x:Name="TrailCheck" Content="Show trail" Checked="ParameterToggle" Unchecked="ParameterToggle" Margin="0,0,0,12"/>
<Grid Margin="0,10,0,0"><TextBlock Text="Length"/><TextBlock Text="{Binding ElementName=LengthSlider,Path=Value,StringFormat={}{0:F0} px}" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}"/></Grid><Slider x:Name="LengthSlider" Minimum="10" Maximum="360"  ValueChanged="ParameterChanged" AutomationProperties.Name="Length"/><Grid Margin="0,10,0,0"><TextBlock Text="Glow intensity"/><TextBlock Text="{Binding ElementName=OpacitySlider,Path=Value,StringFormat={}{0:F0}%}" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}"/></Grid><Slider x:Name="OpacitySlider" Minimum="5" Maximum="85"  ValueChanged="ParameterChanged" AutomationProperties.Name="Glow intensity"/><TextBlock Text="Color" Margin="0,14,0,6"/><StackPanel Orientation="Horizontal" Margin="0,0,0,8"><Button x:Name="IceColor" Style="{StaticResource ColorSelector}" Background="#91DEFF" Tag="#91DEFF" Click="ColorClicked" ToolTip="Ice · #91DEFF" AutomationProperties.Name="Ice color"/><Button x:Name="PurpleColor" Style="{StaticResource ColorSelector}" Background="#B7A8FF" Tag="#B7A8FF" Click="ColorClicked" ToolTip="Purple · #B7A8FF" AutomationProperties.Name="Purple color"/><Button x:Name="AmberColor" Style="{StaticResource ColorSelector}" Background="#FFCE87" Tag="#FFCE87" Click="ColorClicked" ToolTip="Amber · #FFCE87" AutomationProperties.Name="Amber color"/></StackPanel>
            <TextBox x:Name="ColorInput" TextChanged="ColorChanged" AutomationProperties.Name="Effect color in hex"/><TextBlock x:Name="ColorValidation" Text="Use a hex color, for example #87CFFF." Style="{StaticResource Caption}" Margin="0,5,0,0"/>
            <Expander x:Name="TrailAdvanced" Header="Advanced settings"><StackPanel>
<Grid Margin="0,10,0,0"><TextBlock Text="Fade time"/><TextBlock Text="{Binding ElementName=DurationSlider,Path=Value,StringFormat={}{0:F0} ms}" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}"/></Grid><Slider x:Name="DurationSlider" Minimum="80" Maximum="900"  ValueChanged="ParameterChanged" AutomationProperties.Name="Fade time"/><Grid Margin="0,10,0,0"><TextBlock Text="Particle density"/><TextBlock Text="{Binding ElementName=ParticleSlider,Path=Value,StringFormat={}{0:F0}}" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}"/></Grid><Slider x:Name="ParticleSlider" Minimum="0" Maximum="24" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="ParameterChanged" AutomationProperties.Name="Particle density"/></StackPanel></Expander>
          </StackPanel></ScrollViewer></TabItem>
          <TabItem Header="Cursor" Style="{StaticResource SettingsTab}"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,8,4"><TextBlock Text="Windows cursor theme" Style="{StaticResource Caption}"/><ComboBox x:Name="ThemeBox" DisplayMemberPath="Name" SelectionChanged="ThemeChanged" Margin="0,6,0,12" AutomationProperties.Name="Cursor theme"/><Button x:Name="PreviewLatestButton" Content="Preview installed update" Click="PreviewLatestCursor" Visibility="Collapsed" Margin="0,0,0,12"/><TextBlock Text="Try each role in Live Preview. Your choice stays independent of motion and clicks." Style="{StaticResource Caption}"/><Expander x:Name="SystemRecovery" Header="System recovery" Margin="0,18,0,0"><StackPanel><TextBlock Text="Restore the Windows cursor configuration saved before installation. Desktop effects stay independent." Style="{StaticResource Caption}" Margin="0,8,0,12"/><Button x:Name="RestoreButton" Content="Restore Original Cursors" Click="RestoreTheme"/></StackPanel></Expander></StackPanel></ScrollViewer></TabItem>
          <TabItem Header="Click" Style="{StaticResource SettingsTab}"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,8,4"><TextBlock Text="Click feedback" Style="{StaticResource Caption}"/><ComboBox x:Name="ClickBox" SelectionChanged="ClickChanged" Margin="0,6,0,12" AutomationProperties.Name="Click effect"><ComboBoxItem Content="Off" Tag="off"/><ComboBoxItem Content="Soft Halo" Tag="halo"/><ComboBoxItem Content="Ring" Tag="ring"/></ComboBox><TextBlock Text="Left click draws a single ring; right click draws a double ring. Actual input passes through." Style="{StaticResource Caption}"/>
<Grid Margin="0,10,0,0"><TextBlock Text="Click size"/><TextBlock Text="{Binding ElementName=ClickRadiusSlider,Path=Value,StringFormat={}{0:F0} px}" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}"/></Grid><Slider x:Name="ClickRadiusSlider" Minimum="8" Maximum="60"  ValueChanged="ParameterChanged" AutomationProperties.Name="Click size"/><TextBlock Text="Shares your motion color." Style="{StaticResource Caption}" Margin="0,12,0,0"/><Expander x:Name="ClickAdvanced" Header="Advanced settings"><StackPanel><Grid Margin="0,10,0,0"><TextBlock Text="Click duration"/><TextBlock Text="{Binding ElementName=ClickDurationSlider,Path=Value,StringFormat={}{0:F0} ms}" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}"/></Grid><Slider x:Name="ClickDurationSlider" Minimum="80" Maximum="500"  ValueChanged="ParameterChanged" AutomationProperties.Name="Click duration"/><Grid Margin="0,10,0,0"><TextBlock Text="Click intensity"/><TextBlock Text="{Binding ElementName=ClickOpacitySlider,Path=Value,StringFormat={}{0:F0}%}" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}"/></Grid><Slider x:Name="ClickOpacitySlider" Minimum="5" Maximum="85"  ValueChanged="ParameterChanged" AutomationProperties.Name="Click intensity"/></StackPanel></Expander></StackPanel></ScrollViewer></TabItem>
        </TabControl>
        <StackPanel Grid.Row="2" Margin="0,16,0,0"><TextBlock x:Name="DraftStatus" Text="{Binding DraftMessage}" Style="{StaticResource Caption}" Margin="0,0,0,10"/><Button x:Name="ApplyButton" Content="Apply Changes" Style="{StaticResource PrimaryButton}" IsEnabled="{Binding CanApply}" Click="ApplyCombination" ToolTip="Apply to Windows · Ctrl+Enter"/><Button x:Name="CancelButton" Content="Cancel Changes" IsEnabled="{Binding CanCancel}" Click="CancelChanges" Margin="0,8,0,0" ToolTip="Reset draft · Escape"/></StackPanel>
      </Grid>
    </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
