<Window x:Class="Frost.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="FROST / WHITE COMET" Width="980" Height="960" MinWidth="850" MinHeight="650" Background="#0B1424" Foreground="#F7FAFF" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI">
  <Window.Resources>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#DCEAFF"/></Style>
    <Style TargetType="Button"><Setter Property="Background" Value="#1B344E"/><Setter Property="Foreground" Value="#F7FAFF"/><Setter Property="BorderBrush" Value="#42708D"/><Setter Property="Padding" Value="15,10"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#2B506C"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.45"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#91DEFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#E6F1FF"/><Setter Property="Margin" Value="0,6,0,6"/></Style>
    <Style TargetType="Slider"><Setter Property="Margin" Value="0,6,0,12"/><Setter Property="IsMoveToPointEnabled" Value="True"/><Setter Property="Foreground" Value="#91DEFF"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Padding" Value="8,5"/><Setter Property="Foreground" Value="#15263B"/><Setter Property="Margin" Value="0,5,0,12"/></Style>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#142237"/><Setter Property="BorderBrush" Value="#29435D"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="20"/></Style>
    <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Foreground" Value="#9CB3CC"/><Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  </Window.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28,24">
    <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="FROST / WHITE COMET" FontSize="29" FontWeight="Light" Foreground="#F7FAFF"/><TextBlock Text="NATIVE WINDOWS CURSORS / DESKTOP COMET TRAILS" FontSize="12" Foreground="#91DEFF" Margin="2,7,0,0"/></StackPanel><CheckBox x:Name="EnabledCheck" Grid.Column="1" Content="Enable trails" VerticalAlignment="Center" Checked="ToggleChanged" Unchecked="ToggleChanged" AutomationProperties.Name="Enable desktop trails"/></Grid>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
      <StackPanel>
        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="01   NATIVE CURSOR THEME" Foreground="#91DEFF" FontSize="14" Margin="0,0,0,14"/>
          <UniformGrid x:Name="RoleGrid" Columns="5" Rows="3" Margin="0,0,0,12"/>
          <TextBlock x:Name="ThemeStatus" Style="{StaticResource Caption}" Margin="0,0,0,14"/>
          <WrapPanel><Button Content="Install theme" Click="InstallTheme" AutomationProperties.Name="Back up and install the FROST cursor theme"/><Button x:Name="RestoreButton" Content="Restore original theme" Click="RestoreTheme"/></WrapPanel>
          <TextBlock Text="Your current scheme is backed up before installation. The theme remains after the trail engine exits." Style="{StaticResource Caption}" Margin="0,12,0,0"/>
        </StackPanel></Border>
        <Border Style="{StaticResource Card}" Margin="0,18,0,0"><StackPanel><TextBlock Text="02   LIVE DESKTOP TEST" Foreground="#91DEFF" FontSize="14"/><ComboBox x:Name="PreviewRole" SelectionChanged="PreviewChanged" AutomationProperties.Name="Preview cursor role"/>
          <Border x:Name="TestArea" Height="155" CornerRadius="10" BorderBrush="#3C607F" BorderThickness="1" Background="#0B1628"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="#EAF1F7" CornerRadius="9,0,0,9"/><Border Grid.Column="1" Background="#09101B" CornerRadius="0,9,9,0"/><TextBlock Text="Move and click here to test the cursor and trail" Foreground="#71869F" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" IsHitTestVisible="False"/></Grid></Border>
          <TextBlock Text="Real .cur / .ani cursors. Trails are drawn by the running desktop overlay." Style="{StaticResource Caption}" Margin="0,10,0,0"/>
        </StackPanel></Border>
        <TextBlock x:Name="Feedback" TextWrapping="Wrap" Foreground="#91DEFF" Margin="4,14,0,0" FontSize="12"/>
      </StackPanel>
      <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="03   COMET CONTROLS" Foreground="#91DEFF" FontSize="14" Margin="0,0,0,8"/>
        <ComboBox x:Name="PresetBox" SelectionChanged="PresetChanged" AutomationProperties.Name="Trail preset"><ComboBoxItem Content="Minimal"/><ComboBoxItem Content="Standard"/><ComboBoxItem Content="Glow"/><ComboBoxItem Content="Custom"/></ComboBox>
        <DockPanel><TextBlock Text="Trail length"/><TextBlock Text="{Binding ElementName=LengthSlider, Path=Value, StringFormat={}{0:F0} px}" HorizontalAlignment="Right"/></DockPanel><Slider x:Name="LengthSlider" Minimum="10" Maximum="360" ValueChanged="ParameterChanged" AutomationProperties.Name="Maximum trail length in physical pixels"/>
        <DockPanel><TextBlock Text="Fade duration"/><TextBlock Text="{Binding ElementName=DurationSlider, Path=Value, StringFormat={}{0:F0} ms}" HorizontalAlignment="Right"/></DockPanel><Slider x:Name="DurationSlider" Minimum="80" Maximum="900" ValueChanged="ParameterChanged" AutomationProperties.Name="Trail lifetime in milliseconds"/>
        <DockPanel><TextBlock Text="Base opacity"/><TextBlock Text="{Binding ElementName=OpacitySlider, Path=Value, StringFormat={}{0:F0}%}" HorizontalAlignment="Right"/></DockPanel><Slider x:Name="OpacitySlider" Minimum="5" Maximum="85" ValueChanged="ParameterChanged" AutomationProperties.Name="Base trail opacity"/>
        <DockPanel><TextBlock Text="Particle limit"/><TextBlock Text="{Binding ElementName=ParticleSlider, Path=Value, StringFormat={}{0:F0}}" HorizontalAlignment="Right"/></DockPanel><Slider x:Name="ParticleSlider" Minimum="0" Maximum="24" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="ParameterChanged" AutomationProperties.Name="Maximum glow particles"/>
        <TextBlock Text="Effect color"/><WrapPanel Margin="0,8,0,10"><Button Content="Ice" Tag="#91DEFF" Click="ColorClicked"/><Button Content="Cyan" Tag="#62CFFF" Click="ColorClicked"/><Button Content="Lilac" Tag="#B7A8FF" Click="ColorClicked"/></WrapPanel>
        <DockPanel Margin="0,0,0,10"><TextBox x:Name="ColorInput" Width="120" Background="#0B1628" Foreground="#F7FAFF" BorderBrush="#42708D" Padding="8" AutomationProperties.Name="Custom hexadecimal effect color"/><Button Content="Apply color" Click="ApplyColor" Margin="8,0,0,0"/></DockPanel>
        <CheckBox x:Name="HaloCheck" Content="Click halo · 180 ms" Checked="ToggleChanged" Unchecked="ToggleChanged"/><CheckBox x:Name="FullscreenCheck" Content="Pause for fullscreen applications" Checked="ToggleChanged" Unchecked="ToggleChanged"/><CheckBox x:Name="PowerCheck" Content="Power saving · 30 FPS" Checked="ToggleChanged" Unchecked="ToggleChanged"/>
        <ComboBox x:Name="FpsBox" SelectionChanged="FpsChanged" AutomationProperties.Name="Target frame rate"><ComboBoxItem Content="60 FPS · Standard"/><ComboBoxItem Content="120 FPS · High refresh rate"/></ComboBox>
        <CheckBox x:Name="StartupCheck" Content="Start at sign-in (system tray)" Checked="StartupChanged" Unchecked="StartupChanged"/>
        <TextBlock Text="Closing this window keeps FROST in the system tray. Use the tray to disable effects or quit." Style="{StaticResource Caption}" Margin="0,10,0,0"/>
      </StackPanel></Border>
    </Grid>
    <Border BorderBrush="#29435D" BorderThickness="0,1,0,0" Margin="0,22,0,0" Padding="0,12,0,0"><DockPanel><TextBlock x:Name="EngineStatus" Foreground="#91DEFF" FontSize="12"/><TextBlock Text="Effects may be unavailable on secure or protected desktops." Style="{StaticResource Caption}" HorizontalAlignment="Right"/></DockPanel></Border>
  </StackPanel></ScrollViewer>
</Window>
