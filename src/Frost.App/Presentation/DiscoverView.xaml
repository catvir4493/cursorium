<UserControl x:Class="Frost.App.Presentation.DiscoverView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Frost.App" Foreground="{DynamicResource TextBrush}">
 <Grid>
  <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid x:Name="Browse">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,16"><Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="Refresh catalog" Click="RefreshClicked"/><StackPanel><TextBlock Text="Explore" Style="{DynamicResource PageHeader}"/><TextBlock Text="Discover cursor themes and motion presets." Style="{DynamicResource Caption}" Margin="0,6,0,0"/></StackPanel></DockPanel>
   <Grid Grid.Row="1" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="160"/><ColumnDefinition Width="145"/></Grid.ColumnDefinitions><Grid><TextBox x:Name="Search" TextChanged="FilterChanged" AutomationProperties.Name="Search themes, trails or creators" ToolTip="Search themes, trails or creators"/><TextBlock Text="Search themes, trails or creators…" Margin="12,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text,ElementName=Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid><ComboBox x:Name="Category" Grid.Column="1" Margin="10,0,0,0" SelectionChanged="FilterChanged" AutomationProperties.Name="Resource category"/><ComboBox x:Name="Sort" Grid.Column="2" Margin="10,0,0,0" SelectionChanged="FilterChanged" AutomationProperties.Name="Resource sort"><ComboBoxItem Content="Featured"/><ComboBoxItem Content="Recently added"/><ComboBoxItem Content="Name"/></ComboBox></Grid>
   <ScrollViewer x:Name="BrowseScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><TextBlock x:Name="EmptyMessage" Style="{DynamicResource Caption}" Margin="0,24" TextWrapping="Wrap"/><WrapPanel x:Name="Cards" SizeChanged="CardsResized"/></StackPanel></ScrollViewer>
   <DockPanel Grid.Row="3" Margin="0,12,0,0"><Button x:Name="NextPage" DockPanel.Dock="Right" Content="Next" Click="NextClicked"/><Button x:Name="PreviousPage" DockPanel.Dock="Left" Content="Previous" Click="PreviousClicked"/><TextBlock x:Name="PageCount" VerticalAlignment="Center" HorizontalAlignment="Center" Style="{DynamicResource Caption}"/></DockPanel>
  </Grid>
  <Grid x:Name="Details" Visibility="Collapsed">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,16"><Button x:Name="BackButton" Content="← Back" DockPanel.Dock="Left" Click="BackClicked" Margin="0,0,18,0"/><StackPanel><TextBlock x:Name="DetailName" Style="{DynamicResource PageHeader}" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="DetailAuthor" Style="{DynamicResource Caption}"/></StackPanel></DockPanel>
   <ScrollViewer x:Name="DetailScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
    <Border Style="{DynamicResource PreviewPanel}" Padding="18" Margin="0,0,0,16"><StackPanel><Image x:Name="Cover" Height="205" Stretch="Uniform"/><TextBlock x:Name="Description" Style="{DynamicResource Caption}" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel></Border>
    <Border Style="{DynamicResource SettingsSection}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Interactive Preview" FontWeight="SemiBold"/><TextBlock Text="Temporary verified resources. Download adds them to your library; Apply changes Windows." Style="{DynamicResource Caption}" Margin="0,8,0,12"/><Button x:Name="TryPreview" Content="Try Live Preview" Click="TryClicked" HorizontalAlignment="Left"/><Grid x:Name="PreviewHost" Visibility="Collapsed" Margin="0,12,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><DockPanel Margin="0,0,0,8"><ComboBox x:Name="Roles" Width="165" DockPanel.Dock="Right" SelectionChanged="RoleChanged" AutomationProperties.Name="Online preview cursor role"/><Image x:Name="AnimatedImage" Width="40" Height="40" HorizontalAlignment="Left"/></DockPanel><Border Grid.Row="1" Background="{DynamicResource PreviewBrush}" CornerRadius="6" Height="250"><Grid><TextBlock Text="Move and click here · Preview only" Style="{DynamicResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/><local:LivePreview x:Name="DetailPreview" Focusable="True" AutomationProperties.Name="Interactive online cursor and motion preview"/></Grid></Border></Grid></StackPanel></Border>
    <Border Style="{DynamicResource SettingsSection}"><StackPanel><TextBlock Text="Resource information" FontWeight="SemiBold"/><TextBlock x:Name="Information" Style="{DynamicResource Caption}" Margin="0,12,0,12" TextWrapping="Wrap"/><Button x:Name="Source" Content="View original source ↗" HorizontalAlignment="Left" Click="SourceClicked"/></StackPanel></Border>
   </StackPanel></ScrollViewer>
   <Grid Grid.Row="2" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="DetailStatus" Style="{DynamicResource Caption}" VerticalAlignment="Center" TextWrapping="Wrap"/><Button x:Name="DetailFavorite" Grid.Column="1" Content="☆ Favorite" Click="DetailFavoriteClicked" Margin="12,0"/><Button x:Name="Download" Grid.Column="2" Content="Download" Style="{DynamicResource PrimaryButton}" Click="DownloadClicked" MinWidth="150"/></Grid>
  </Grid>
  <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,12,0,0"><StackPanel><DockPanel><Button x:Name="CancelDownload" DockPanel.Dock="Right" Content="Cancel download" Click="CancelClicked" Visibility="Collapsed"/><TextBlock x:Name="Status" Style="{DynamicResource Caption}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/></DockPanel><ProgressBar x:Name="Progress" Height="4" Minimum="0" Maximum="100" Visibility="Collapsed" Margin="0,8,0,0"/></StackPanel></Border>
 </Grid>
</UserControl>
