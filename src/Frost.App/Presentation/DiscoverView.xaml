<UserControl x:Class="Frost.App.Presentation.DiscoverView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Frost.App" Foreground="{DynamicResource TextBrush}">
 <Grid>
  <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid x:Name="Browse">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,16"><Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="Refresh catalog" Click="RefreshClicked"/><StackPanel><TextBlock Text="Explore" Style="{DynamicResource PageHeader}"/><TextBlock Text="Discover cursor themes and motion presets." Style="{DynamicResource Caption}" Margin="0,6,0,0"/></StackPanel></DockPanel>
   <Grid Grid.Row="1" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="160"/><ColumnDefinition Width="145"/></Grid.ColumnDefinitions><Grid><TextBox x:Name="Search" TextChanged="FilterChanged" AutomationProperties.Name="Search themes, trails or creators" ToolTip="Search themes, trails or creators"/><TextBlock Text="Search themes, trails or creators…" Margin="12,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text,ElementName=Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid><ComboBox x:Name="Category" Grid.Column="1" Margin="10,0,0,0" SelectionChanged="FilterChanged" AutomationProperties.Name="Resource category"/><ComboBox x:Name="Sort" Grid.Column="2" Margin="10,0,0,0" SelectionChanged="FilterChanged" AutomationProperties.Name="Resource sort"><ComboBoxItem Content="Featured"/><ComboBoxItem Content="Recently added"/><ComboBoxItem Content="Name"/></ComboBox></Grid>
   <ScrollViewer x:Name="BrowseScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
    <StackPanel x:Name="CollectionsHost" Visibility="Collapsed" Margin="0,0,0,18"><DockPanel Margin="0,0,0,10"><Button x:Name="ClearCollection" Content="All resources" DockPanel.Dock="Right" Click="ClearCollectionClicked" Visibility="Collapsed"/><TextBlock x:Name="CollectionHeading" Text="Featured collections" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel x:Name="CollectionCards" Orientation="Horizontal"/></ScrollViewer></StackPanel>
    <TextBlock x:Name="EmptyMessage" Style="{DynamicResource Caption}" Margin="0,24" TextWrapping="Wrap"/><WrapPanel x:Name="Cards" SizeChanged="CardsResized"/></StackPanel></ScrollViewer>
   <DockPanel Grid.Row="3" Margin="0,12,0,0"><Button x:Name="NextPage" DockPanel.Dock="Right" Content="Next" Click="NextClicked"/><Button x:Name="PreviousPage" DockPanel.Dock="Left" Content="Previous" Click="PreviousClicked"/><TextBlock x:Name="PageCount" VerticalAlignment="Center" HorizontalAlignment="Center" Style="{DynamicResource Caption}"/></DockPanel>
  </Grid>
  <Grid x:Name="Details" Visibility="Collapsed" SizeChanged="DetailsResized">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,14"><Button x:Name="BackButton" Content="← Back" DockPanel.Dock="Left" Click="BackClicked" Margin="0,0,16,0"/><TextBlock Text="Explore / Resource details" Style="{DynamicResource Caption}" VerticalAlignment="Center"/></DockPanel>
   <ScrollViewer x:Name="DetailScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
    <Grid x:Name="DetailHero" Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition x:Name="HeroCoverColumn" Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,20,0"><Border Style="{DynamicResource PreviewPanel}" ClipToBounds="True"><Image x:Name="Cover" Height="300" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/></Border><UniformGrid x:Name="HeroRoles" Rows="1" Margin="0,10,0,0"/></StackPanel>
     <StackPanel Grid.Column="1"><TextBlock x:Name="DetailName" FontSize="25" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxHeight="68"/><TextBlock x:Name="DetailAuthor" Style="{DynamicResource Caption}" Margin="0,6,0,10"/><TextBlock x:Name="DetailTags" Foreground="{DynamicResource AccentBrush}" FontSize="11" TextWrapping="Wrap"/><TextBlock x:Name="Description" Style="{DynamicResource Caption}" TextWrapping="Wrap" Margin="0,12,0,14" MaxHeight="64" TextTrimming="CharacterEllipsis"/>
      <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="Download" Content="Download" Style="{DynamicResource PrimaryButton}" Click="DownloadClicked" MinWidth="135"/><Button x:Name="DetailFavorite" Grid.Column="1" Content="☆" ToolTip="Favorite resource" AutomationProperties.Name="Favorite resource" Click="DetailFavoriteClicked" Width="42" Margin="8,0,0,0" Padding="0"/></Grid>
      <TextBlock x:Name="DetailStatus" Foreground="{DynamicResource SuccessBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/><TextBlock x:Name="Overview" Style="{DynamicResource Caption}" TextWrapping="Wrap" LineHeight="20"/>
     </StackPanel>
    </Grid>
    <Border Style="{DynamicResource SettingsSection}" Padding="16" Margin="0,0,0,12"><StackPanel>
     <DockPanel><Button x:Name="TryPreview" DockPanel.Dock="Right" Content="Try Live Preview" Click="TryClicked" Margin="12,0,0,0"/><StackPanel><TextBlock Text="Interactive Preview" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="Move and click to test. Preview never changes Windows." Style="{DynamicResource Caption}" Margin="0,6,0,0"/></StackPanel></DockPanel>
     <Grid x:Name="PreviewHost" Visibility="Collapsed" Margin="0,12,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
      <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><ComboBox x:Name="Roles" MaxWidth="190" HorizontalAlignment="Left" SelectionChanged="RoleChanged" AutomationProperties.Name="Online preview cursor role"/><ComboBox x:Name="ObservationZoom" Grid.Column="1" SelectionChanged="ZoomChanged" AutomationProperties.Name="Cursor observation magnification"><ComboBoxItem Content="Actual size" Tag="1"/><ComboBoxItem Content="2×" Tag="2"/><ComboBoxItem Content="4×" Tag="4"/></ComboBox></Grid>
      <Border Grid.Row="1" Background="{DynamicResource PreviewBrush}" CornerRadius="6" Height="260" ClipToBounds="True"><Grid>
       <Grid.Background><DrawingBrush TileMode="Tile" Viewport="0,0,24,24" ViewportUnits="Absolute"><DrawingBrush.Drawing><GeometryDrawing Brush="{DynamicResource PreviewBrush}"><GeometryDrawing.Pen><Pen Brush="{DynamicResource PreviewGridBrush}" Thickness="0.5"/></GeometryDrawing.Pen><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,24,24"/></GeometryDrawing.Geometry></GeometryDrawing></DrawingBrush.Drawing></DrawingBrush></Grid.Background>
       <Image x:Name="AnimatedImage" Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
       <TextBlock Text="PREVIEW ONLY · original cursor timing and hotspots" Style="{DynamicResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="8,0,8,12" IsHitTestVisible="False"/>
       <local:LivePreview x:Name="DetailPreview" Focusable="True" AutomationProperties.Name="Interactive online cursor and motion preview"/>
      </Grid></Border>
     </Grid>
    </StackPanel></Border>
    <Expander x:Name="TechnicalDetails" Header="Technical Details" IsExpanded="False"><Border Style="{DynamicResource SettingsSection}" Padding="16"><StackPanel><TextBlock x:Name="Information" Style="{DynamicResource Caption}" TextWrapping="Wrap" LineHeight="19"/><Button x:Name="Source" Content="View original source ↗" HorizontalAlignment="Left" Click="SourceClicked" Margin="0,12,0,0"/></StackPanel></Border></Expander>
   </StackPanel></ScrollViewer>
  </Grid>
  <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,12,0,0"><StackPanel><DockPanel><Button x:Name="CancelDownload" DockPanel.Dock="Right" Content="Cancel download" Click="CancelClicked" Visibility="Collapsed"/><TextBlock x:Name="Status" Style="{DynamicResource Caption}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/></DockPanel><ProgressBar x:Name="Progress" Height="4" Minimum="0" Maximum="100" Visibility="Collapsed" Margin="0,8,0,0"/></StackPanel></Border>
 </Grid>
</UserControl>
