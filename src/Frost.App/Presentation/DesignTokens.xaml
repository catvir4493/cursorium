<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <SolidColorBrush x:Key="WindowBrush" Color="#0D1422"/>
  <SolidColorBrush x:Key="SurfaceBrush" Color="#131E30"/>
  <SolidColorBrush x:Key="CardBrush" Color="#172338"/>
  <SolidColorBrush x:Key="ControlBrush" Color="#111C2D"/>
  <SolidColorBrush x:Key="HoverBrush" Color="#1F3048"/>
  <SolidColorBrush x:Key="SelectedBrush" Color="#203B53"/>
  <SolidColorBrush x:Key="TextBrush" Color="#F3F6FB"/>
  <SolidColorBrush x:Key="MutedBrush" Color="#A3B3C8"/>
  <SolidColorBrush x:Key="QuietBrush" Color="#8195AD"/>
  <SolidColorBrush x:Key="AccentBrush" Color="#87CFFF"/>
  <SolidColorBrush x:Key="AccentHoverBrush" Color="#A4DCFF"/>
  <SolidColorBrush x:Key="BorderBrush" Color="#27364A"/>
  <SolidColorBrush x:Key="StrongBorderBrush" Color="#455C76"/>
  <SolidColorBrush x:Key="SuccessBrush" Color="#94D5BB"/>
  <SolidColorBrush x:Key="ErrorBrush" Color="#F0A5AE"/>
  <SolidColorBrush x:Key="PreviewBrush" Color="#101B2D"/>
  <SolidColorBrush x:Key="PreviewGridBrush" Color="#19283D"/>
  <sys:Double x:Key="CaptionSize">11</sys:Double>
  <sys:Double x:Key="BodySize">13</sys:Double>
  <sys:Double x:Key="SectionSize">14</sys:Double>
  <sys:Double x:Key="HeadingSize">25</sys:Double>
  <Thickness x:Key="ControlPadding">10,8</Thickness>
  <Thickness x:Key="SectionSpacing">0,0,0,18</Thickness>
  <CornerRadius x:Key="ControlRadius">6</CornerRadius>
  <CornerRadius x:Key="PanelRadius">10</CornerRadius>
  <Style x:Key="KeyboardFocus" TargetType="Control"><Setter Property="Template"><Setter.Value><ControlTemplate><Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="4" Margin="2"/></ControlTemplate></Setter.Value></Setter></Style>
</ResourceDictionary>
