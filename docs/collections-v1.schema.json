{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CURSORIUM signed collections v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["SchemaVersion", "Version", "MinimumCatalogVersion", "Collections"],
  "properties": {
    "SchemaVersion": {"const": 1},
    "Version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "MinimumCatalogVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "Collections": {
      "type": "array", "maxItems": 24,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["Id", "Name", "Description", "CoverUrl", "ResourceIds"],
        "properties": {
          "Id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"},
          "Name": {"type": "string", "minLength": 1, "maxLength": 80},
          "Description": {"type": "string", "maxLength": 400},
          "CoverUrl": {"type": "string", "format": "uri", "pattern": "^https://catvir4493\\.github\\.io/cursorium-library/catalog/v1/"},
          "ResourceIds": {"type": "array", "minItems": 1, "maxItems": 2000, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"}}
        }
      }
    }
  }
}
